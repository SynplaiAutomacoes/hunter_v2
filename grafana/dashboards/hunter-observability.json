{
  "title": "Hunter - Observability",
  "uid": "hunter-observability",
  "tags": ["hunter", "monitoring", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "custom",
        "current": { "value": "production", "text": "production" },
        "options": [
          { "value": "production", "text": "Produção" },
          { "value": "staging", "text": "Homologação" },
          { "value": "development", "text": "Desenvolvimento" }
        ]
      },
      {
        "name": "service_name",
        "label": "Serviço",
        "type": "custom",
        "current": { "value": "hunter-web", "text": "hunter-web" },
        "options": [
          { "value": "hunter-web", "text": "hunter-web" }
        ]
      },
      {
        "name": "rate_interval",
        "label": "Janela rate",
        "type": "interval",
        "current": { "value": "$__rate_interval", "text": "auto" },
        "options": [
          { "value": "$__rate_interval", "text": "Auto" },
          { "value": "2m", "text": "2 min" },
          { "value": "5m", "text": "5 min" },
          { "value": "10m", "text": "10 min" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumo - Ambientes",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": [
        {
          "id": 11,
          "type": "stat",
          "title": "RPS total",
          "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval]))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } }
        },
        {
          "id": 12,
          "type": "stat",
          "title": "p95 latência total",
          "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 1000 }] } } }
        },
        {
          "id": 13,
          "type": "stat",
          "title": "Erro 5xx",
          "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(rate(http_server_request_errors_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval]))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.1 }] } } }
        },
        {
          "id": 14,
          "type": "stat",
          "title": "Requests ativas",
          "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(http_server_active_requests{deployment_environment=~\"$environment\", service_name=\"$service_name\"})", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 }] } } }
        }
      ]
    },
    {
      "id": 2,
      "type": "row",
      "title": "HTTP - Requests",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": [
        {
          "id": 21,
          "type": "timeseries",
          "title": "RPS por rota",
          "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 },
          "targets": [
            { "expr": "sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (http_route)", "refId": "A", "legendFormat": "{{http_route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
        },
        {
          "id": 22,
          "type": "timeseries",
          "title": "p95 latência por rota",
          "gridPos": { "x": 12, "y": 6, "w": 12, "h": 7 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, http_route))", "refId": "A", "legendFormat": "{{http_route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 23,
          "type": "timeseries",
          "title": "p50 / p95 / p99 global",
          "gridPos": { "x": 0, "y": 13, "w": 8, "h": 6 },
          "targets": [
            { "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "A", "legendFormat": "p50" },
            { "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "B", "legendFormat": "p95" },
            { "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "C", "legendFormat": "p99" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 24,
          "type": "timeseries",
          "title": "Error rate por rota (%)",
          "gridPos": { "x": 8, "y": 13, "w": 8, "h": 6 },
          "targets": [
            { "expr": "(sum(rate(http_server_request_errors_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (http_route) / sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (http_route)) * 100", "refId": "A", "legendFormat": "{{http_route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 25,
          "type": "table",
          "title": "Todas as rotas - latência e volume",
          "gridPos": { "x": 16, "y": 13, "w": 8, "h": 6 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, http_route))", "refId": "A", "format": "table", "instant": true }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": [
              { "matcher": { "id": "byName", "options": "http_route" }, "properties": [{ "id": "custom.width", "value": 250 }] },
              { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "p95 (ms)" }] }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Database - SQL",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 31,
          "type": "timeseries",
          "title": "SQL time médio por rota (via Loki)",
          "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
          "targets": [
            { "expr": "avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap sql_time_ms [$__interval]))", "refId": "A", "legendFormat": "{{route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 32,
          "type": "timeseries",
          "title": "Query count médio por rota",
          "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
          "targets": [
            { "expr": "avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap query_count [$__interval]))", "refId": "A", "legendFormat": "{{route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 33,
          "type": "table",
          "title": "Rotas por query count (N+1 candidates)",
          "gridPos": { "x": 0, "y": 27, "w": 8, "h": 7 },
          "targets": [
            { "expr": "avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap query_count [$__range]))", "refId": "A", "format": "table", "instant": true }
          ],
          "fieldConfig": {
            "defaults": { "unit": "none" },
            "overrides": [
              { "matcher": { "id": "byName", "options": "route" }, "properties": [{ "id": "custom.width", "value": 250 }] },
              { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "avg q/req" }, { "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 }] } }] }
            ]
          }
        },
        {
          "id": 34,
          "type": "table",
          "title": "Rotas por SQL time médio",
          "gridPos": { "x": 8, "y": 27, "w": 8, "h": 7 },
          "targets": [
            { "expr": "avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap sql_time_ms [$__range]))", "refId": "A", "format": "table", "instant": true }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": [
              { "matcher": { "id": "byName", "options": "route" }, "properties": [{ "id": "custom.width", "value": 250 }] },
              { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "avg SQL ms" }] }
            ]
          }
        },
        {
          "id": 35,
          "type": "timeseries",
          "title": "% do tempo da request gasto em SQL",
          "gridPos": { "x": 16, "y": 27, "w": 8, "h": 7 },
          "targets": [
            { "expr": "avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap sql_time_ms [$__interval])) / avg by (route) (avg_over_time({logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | route != \"\" | unwrap duration_ms [$__interval])) * 100", "refId": "A", "legendFormat": "{{route}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "lineWidth": 2 } } }
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "External Dependencies",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 41,
          "type": "stat",
          "title": "Chamadas / min",
          "gridPos": { "x": 0, "y": 36, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(rate(dependency_client_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval]))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqpm" } }
        },
        {
          "id": 42,
          "type": "stat",
          "title": "Erros (5 min)",
          "gridPos": { "x": 6, "y": 36, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(increase(dependency_client_error_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[5m])) by (dependency_name) > 0", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
        },
        {
          "id": 43,
          "type": "stat",
          "title": "p95 global",
          "gridPos": { "x": 12, "y": 36, "w": 6, "h": 4 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(dependency_client_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms" } }
        },
        {
          "id": 44,
          "type": "stat",
          "title": "Error rate global (%)",
          "gridPos": { "x": 18, "y": 36, "w": 6, "h": 4 },
          "targets": [
            { "expr": "(sum(rate(dependency_client_error_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) / sum(rate(dependency_client_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval]))) * 100", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } } }
        },
        {
          "id": 45,
          "type": "timeseries",
          "title": "p95 por provider",
          "gridPos": { "x": 0, "y": 40, "w": 12, "h": 7 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(dependency_client_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, dependency_name))", "refId": "A", "legendFormat": "{{dependency_name}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 46,
          "type": "timeseries",
          "title": "Throughput por provider",
          "gridPos": { "x": 12, "y": 40, "w": 12, "h": 7 },
          "targets": [
            { "expr": "sum(rate(dependency_client_request_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (dependency_name, operation)", "refId": "A", "legendFormat": "{{dependency_name}}.{{operation}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
        },
        {
          "id": 47,
          "type": "table",
          "title": "Todas as operações - p95 por provider e operação",
          "gridPos": { "x": 0, "y": 47, "w": 12, "h": 7 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(dependency_client_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, dependency_name, operation))", "refId": "A", "format": "table", "instant": true }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": [
              { "matcher": { "id": "byName", "options": "dependency_name" }, "properties": [{ "id": "custom.width", "value": 110 }] },
              { "matcher": { "id": "byName", "options": "operation" }, "properties": [{ "id": "custom.width", "value": 220 }] },
              { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "p95 (ms)" }, { "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 5000 }] } }] }
            ]
          }
        },
        {
          "id": 48,
          "type": "timeseries",
          "title": "Erros por provider (stacked)",
          "gridPos": { "x": 12, "y": 47, "w": 12, "h": 7 },
          "targets": [
            { "expr": "sum(increase(dependency_client_error_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (dependency_name, operation) > 0", "refId": "A", "legendFormat": "{{dependency_name}}.{{operation}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "none", "custom": { "stacking": { "mode": "normal" }, "lineWidth": 2 } } }
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Business Operations",
      "gridPos": { "x": 0, "y": 55, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 51,
          "type": "stat",
          "title": "Operações / min",
          "gridPos": { "x": 0, "y": 56, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(rate(business_operation_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval]))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "opm" } }
        },
        {
          "id": 52,
          "type": "stat",
          "title": "Falhas (5 min)",
          "gridPos": { "x": 6, "y": 56, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(increase(business_operation_error_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[5m]))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
        },
        {
          "id": 53,
          "type": "stat",
          "title": "p95 global",
          "gridPos": { "x": 12, "y": 56, "w": 6, "h": 4 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(business_operation_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le))", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms" } }
        },
        {
          "id": 54,
          "type": "stat",
          "title": "Falhas por operação",
          "gridPos": { "x": 18, "y": 56, "w": 6, "h": 4 },
          "targets": [
            { "expr": "sum(increase(business_operation_error_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[5m])) by (operation_name) > 0", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
        },
        {
          "id": 55,
          "type": "timeseries",
          "title": "p95 por operação",
          "gridPos": { "x": 0, "y": 60, "w": 12, "h": 7 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(business_operation_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, operation_name))", "refId": "A", "legendFormat": "{{operation_name}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
        },
        {
          "id": 56,
          "type": "table",
          "title": "Todas as operações - p95, grupo e falhas",
          "gridPos": { "x": 12, "y": 60, "w": 12, "h": 7 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(business_operation_duration_bucket{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (le, operation_name, operation_group))", "refId": "A", "format": "table", "instant": true }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": [
              { "matcher": { "id": "byName", "options": "operation_group" }, "properties": [{ "id": "custom.width", "value": 100 }] },
              { "matcher": { "id": "byName", "options": "operation_name" }, "properties": [{ "id": "custom.width", "value": 250 }] },
              { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "p95 (ms)" }, { "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 5000 }] } }] }
            ]
          }
        },
        {
          "id": 57,
          "type": "timeseries",
          "title": "Execuções por operação",
          "gridPos": { "x": 0, "y": 67, "w": 24, "h": 6 },
          "targets": [
            { "expr": "sum(rate(business_operation_count_total{deployment_environment=~\"$environment\", service_name=\"$service_name\"}[$rate_interval])) by (operation_group, operation_name)", "refId": "A", "legendFormat": "{{operation_group}}.{{operation_name}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Logs & Traces",
      "gridPos": { "x": 0, "y": 74, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 61,
          "type": "logs",
          "title": "Requests",
          "gridPos": { "x": 0, "y": 75, "w": 24, "h": 12 },
          "targets": [
            { "expr": "{logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | line_format \"{{.method}}  {{.status_code}}  {{.route}}    {{.duration_ms}}ms    {{.query_count}}q    {{.sql_time_ms}}ms_sql\"", "refId": "A" }
          ],
          "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending" }
        },
        {
          "id": 62,
          "type": "logs",
          "title": "Requests lentas (> 500ms)",
          "gridPos": { "x": 0, "y": 87, "w": 12, "h": 8 },
          "targets": [
            { "expr": "{logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | duration_ms > 500 | line_format \"[{{.method}}]  {{.route}}  {{.duration_ms}}ms  status={{.status_code}}\"", "refId": "A" }
          ],
          "options": { "dedupStrategy": "none", "enableLogDetails": true, "sortOrder": "Descending" }
        },
        {
          "id": 63,
          "type": "logs",
          "title": "Requests com erro 5xx",
          "gridPos": { "x": 12, "y": 87, "w": 12, "h": 8 },
          "targets": [
            { "expr": "{logger=\"apps.core.presentation.middlewares\", environment=~\"$environment\"} | json | status_code >= 500 | line_format \"[{{.method}}]  {{.route}}  status={{.status_code}}  {{.duration_ms}}ms  q={{.query_count}}\"", "refId": "A" }
          ],
          "options": { "dedupStrategy": "none", "enableLogDetails": true, "sortOrder": "Descending" }
        },
        {
          "id": 64,
          "type": "logs",
          "title": "Dependencies",
          "gridPos": { "x": 0, "y": 95, "w": 12, "h": 8 },
          "targets": [
